# Copie este archivo como .env y genere secretos reales con:
#   python -m app.cli gen-keys
# NUNCA suba el archivo .env al repositorio.

ENVIRONMENT=development
LOG_LEVEL=INFO

# postgres (PostgreSQL + PostGIS)  |  memory (demo sin base de datos)
REPOSITORY_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://alerta:alerta@localhost:5432/alerta_sin_red

JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=30
PHONE_ENCRYPTION_KEY=cambiar-por-clave-fernet
PHONE_INDEX_KEY=cambiar-por-clave-hmac

CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

ADMIN_EMAIL=admin@alertasinred.co
ADMIN_PASSWORD=cambiar-esta-clave

# open_meteo (datos reales)  |  fake (simulado: seco, lluvioso, tormenta)
WEATHER_PROVIDER=open_meteo
FAKE_WEATHER_SCENARIO=tormenta
# Minutos que se reutiliza el clima de una misma coordenada (0 = sin caché)
WEATHER_CACHE_MINUTES=15

# console (log)  |  twilio  |  android_gateway
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ANDROID_GATEWAY_URL=http://192.168.1.50:8080
# ANDROID_GATEWAY_USER=
# ANDROID_GATEWAY_PASSWORD=

ALERT_COOLDOWN_HOURS=6
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60

# Documentación /docs en producción (solo para demostraciones)
EXPOSE_DOCS=false
